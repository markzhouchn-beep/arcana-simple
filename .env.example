# —— 服务器 ——
PORT=3001
DATABASE_PATH=./data/arcana.db
JWT_SECRET=change-me
ADMIN_PASSWORD_HASH=   # bcrypt(admin 密码)

# —— 支付宝 WAP ——
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your.domain/api/alipay/notify
ALIPAY_RETURN_URL=https://your.domain/pay/return
ALIPAY_SANDBOX=false

# —— PayPal ——
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=          # 必填，否则验签跳过
PAYPAL_MODE=sandbox         # sandbox | live

# —— AI ——
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini